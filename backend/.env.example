# Direct CPU-only mock: FastAPI returns deterministic semantics without a network request.
VLM_MODE=mock

# HTTP mock or future production VLM: uncomment VLM_MODE and use an endpoint.
# VLM_MODE=remote
# VLM_URL=http://localhost:9000/analyze
# VLM_TIMEOUT_SECONDS=60

# mock_vlm_server-only testing controls; do not set these for the main backend.
# MOCK_VLM_DELAY_SECONDS=0
# MOCK_VLM_FAILURE_RATE=0